# Waka Tourisme V1 — example only. Never commit real production secrets.

# Branding / runtime
NEXT_PUBLIC_APP_NAME=Waka Tourisme
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=contact@example.com
NEXT_PUBLIC_LEGAL_PUBLISHER_NAME="À renseigner avant mise en production"

# Supabase — optional for demo mode, required for persistent production accounts/data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Required for server-side analytics/lead ingestion.
SUPABASE_SERVICE_ROLE_KEY=

# Mapping / routing adapters
NEXT_PUBLIC_MAP_PROVIDER=osm
ROUTING_PROVIDER=osrm
MAPBOX_ACCESS_TOKEN=
OPENROUTESERVICE_API_KEY=

# Weather
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# Feature flags
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_BETA_MODE=true
